<UserControl x:Class="DesktopFences.UI.Controls.FencePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:DesktopFences.UI.ViewModels"
             xmlns:ctrl="clr-namespace:DesktopFences.UI.Controls"
             x:Name="Root"
             AllowDrop="True"
             Drop="OnDrop"
             DragOver="OnDragOver"
             DragLeave="OnDragLeave"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ═════ Custom file tile: 彩色类型图标 + 字母叠加 ═════ -->
        <DataTemplate x:Key="CustomFileTile">
            <Border x:Name="ItemBorder"
                    Width="{DynamicResource FileTileWidth}"
                    Height="{DynamicResource FileTileHeight}"
                    Margin="2"
                    CornerRadius="4"
                    Background="Transparent"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    MouseLeftButtonDown="FileItem_MouseLeftButtonDown"
                    MouseRightButtonUp="FileItem_MouseRightButtonUp"
                    MouseMove="FileItem_MouseMove"
                    ToolTip="{Binding FilePath}">
                <!-- 外 Grid 撑满 Border（默认 Stretch），把 cell 拆成 icon 行 + 文字行两个固定槽位，
                     避免 StackPanel/Center 模式下尺寸由内容反推导致 icon 中心随文字长短/wrap 行数漂移 -->
                <Grid Margin="4" SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0"
                          Width="{DynamicResource FileTileIconSize}"
                          Height="{DynamicResource FileTileIconSize}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Image Source="{Binding Extension, Converter={StaticResource KindToIcon}}"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{Binding KindLabel}"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   FontSize="{Binding KindLabel, Converter={StaticResource LabelLenToSize}}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,5"
                                   IsHitTestVisible="False"
                                   Effect="{StaticResource TileBadgeShadow}"/>
                    </Grid>
                    <TextBlock Grid.Row="1"
                               Text="{Binding DisplayName}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="11"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="32"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Top"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"
                               Margin="0,4,0,0"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="ItemBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═════ System file tile: Windows 经典 page-with-fold + colored badge + 字母 ═════ -->
        <DataTemplate x:Key="SystemFileTile">
            <Border x:Name="ItemBorder"
                    Width="{DynamicResource FileTileWidth}"
                    Height="{DynamicResource FileTileHeight}"
                    Margin="2"
                    CornerRadius="4"
                    Background="Transparent"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    MouseLeftButtonDown="FileItem_MouseLeftButtonDown"
                    MouseRightButtonUp="FileItem_MouseRightButtonUp"
                    MouseMove="FileItem_MouseMove"
                    ToolTip="{Binding FilePath}">
                <Grid Margin="4" SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0"
                          Width="{DynamicResource FileTileIconSize}"
                          Height="{DynamicResource FileTileIconSize}"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center">
                        <Image Source="{Binding Extension, Converter={StaticResource SysKindToIcon}}"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="{Binding SystemBadgeText}"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   FontFamily="Segoe UI"
                                   FontSize="{Binding SystemBadgeText, Converter={StaticResource LabelLenToSize}}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Bottom"
                                   Margin="0,0,0,5"
                                   IsHitTestVisible="False"
                                   Effect="{StaticResource SysBadgeShadow}"/>
                    </Grid>
                    <TextBlock Grid.Row="1"
                               Text="{Binding DisplayName}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="11"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="32"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Top"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"
                               Margin="0,4,0,0"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="ItemBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═════ Shell file tile: 走 ShellIconExtractor 的系统图标 ═════ -->
        <DataTemplate x:Key="ShellFileTile">
            <Border x:Name="ItemBorder"
                    Width="{DynamicResource FileTileWidth}"
                    Height="{DynamicResource FileTileHeight}"
                    Margin="2"
                    CornerRadius="4"
                    Background="Transparent"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    MouseLeftButtonDown="FileItem_MouseLeftButtonDown"
                    MouseRightButtonUp="FileItem_MouseRightButtonUp"
                    MouseMove="FileItem_MouseMove"
                    ToolTip="{Binding FilePath}">
                <Grid Margin="4" SnapsToDevicePixels="True" UseLayoutRounding="True">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Image Grid.Row="0"
                           Source="{Binding Icon, IsAsync=True}"
                           Width="{DynamicResource FileTileIconSize}"
                           Height="{DynamicResource FileTileIconSize}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           SnapsToDevicePixels="True"
                           UseLayoutRounding="True"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Row="1"
                               Text="{Binding DisplayName}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="11"
                               TextAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               MaxHeight="32"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Top"
                               SnapsToDevicePixels="True"
                               UseLayoutRounding="True"
                               Margin="0,4,0,0"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="ItemBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═════ Phase 14: List file tile — 小图标 + 单行文件名（纵向多列流式）═════
             图标源按 fence 的 EffectiveIconStyle 切换（不带字母叠加，小尺寸不可读）。-->
        <DataTemplate x:Key="ListFileTile">
            <Border x:Name="ItemBorder"
                    Width="{DynamicResource FileListItemWidth}"
                    Height="22"
                    Margin="1"
                    CornerRadius="3"
                    Background="Transparent"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    MouseLeftButtonDown="FileItem_MouseLeftButtonDown"
                    MouseRightButtonUp="FileItem_MouseRightButtonUp"
                    MouseMove="FileItem_MouseMove"
                    ToolTip="{Binding FilePath}">
                <StackPanel Orientation="Horizontal" Margin="5,0" VerticalAlignment="Center">
                    <Grid Width="{DynamicResource FileListIconSize}"
                          Height="{DynamicResource FileListIconSize}"
                          VerticalAlignment="Center">
                        <Image x:Name="CustomIcon"
                               Source="{Binding Extension, Converter={StaticResource KindToIcon}}"
                               Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Image x:Name="SystemIcon"
                               Source="{Binding Extension, Converter={StaticResource SysKindToIcon}}"
                               Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <Image x:Name="ShellIcon"
                               Source="{Binding Icon, IsAsync=True}"
                               Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Grid>
                    <TextBlock Text="{Binding DisplayName}"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               FontSize="11"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DataContext.EffectiveIconStyle, RelativeSource={RelativeSource AncestorType=ctrl:FencePanel}}" Value="App">
                    <Setter TargetName="CustomIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.EffectiveIconStyle, RelativeSource={RelativeSource AncestorType=ctrl:FencePanel}}" Value="System">
                    <Setter TargetName="SystemIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.EffectiveIconStyle, RelativeSource={RelativeSource AncestorType=ctrl:FencePanel}}" Value="Shell">
                    <Setter TargetName="ShellIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <Trigger SourceName="ItemBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═════ Phase 14: Detail file tile — 单列行：图标+名称 / 大小 / 修改时间 ═════ -->
        <DataTemplate x:Key="DetailFileTile">
            <Border x:Name="ItemBorder"
                    Height="{DynamicResource DetailRowHeight}"
                    CornerRadius="2"
                    Background="Transparent"
                    HorizontalAlignment="Stretch"
                    SnapsToDevicePixels="True"
                    UseLayoutRounding="True"
                    MouseLeftButtonDown="FileItem_MouseLeftButtonDown"
                    MouseRightButtonUp="FileItem_MouseRightButtonUp"
                    MouseMove="FileItem_MouseMove"
                    ToolTip="{Binding FilePath}">
                <Grid Margin="6,0,6,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="118"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Grid Width="{DynamicResource FileListIconSize}"
                              Height="{DynamicResource FileListIconSize}"
                              VerticalAlignment="Center">
                            <Image x:Name="CustomIcon"
                                   Source="{Binding Extension, Converter={StaticResource KindToIcon}}"
                                   Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Image x:Name="SystemIcon"
                                   Source="{Binding Extension, Converter={StaticResource SysKindToIcon}}"
                                   Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                            <Image x:Name="ShellIcon"
                                   Source="{Binding Icon, IsAsync=True}"
                                   Visibility="Collapsed"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Grid>
                        <TextBlock Text="{Binding DisplayName}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="11"
                                   Margin="7,0,0,0"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               Text="{Binding SizeDisplay}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextAlignment="Right"
                               Margin="0,0,12,0"/>
                    <TextBlock Grid.Column="2"
                               Text="{Binding DateModifiedDisplay}"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               FontSize="11"
                               VerticalAlignment="Center"
                               TextAlignment="Left"/>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DataContext.EffectiveIconStyle, RelativeSource={RelativeSource AncestorType=ctrl:FencePanel}}" Value="App">
                    <Setter TargetName="CustomIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.EffectiveIconStyle, RelativeSource={RelativeSource AncestorType=ctrl:FencePanel}}" Value="System">
                    <Setter TargetName="SystemIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.EffectiveIconStyle, RelativeSource={RelativeSource AncestorType=ctrl:FencePanel}}" Value="Shell">
                    <Setter TargetName="ShellIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <Trigger SourceName="ItemBorder" Property="IsMouseOver" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HoverBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectedBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ═════ Phase 14: ItemsPanel — 按 ViewMode 切换（见 FileListBox 的 Style）═════ -->
        <ItemsPanelTemplate x:Key="IconItemsPanel">
            <WrapPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListItemsPanel">
            <!-- 纵向流式：列满换列，水平滚动（Explorer 列表视图行为）-->
            <WrapPanel Orientation="Vertical" />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="DetailItemsPanel">
            <VirtualizingStackPanel Orientation="Vertical" />
        </ItemsPanelTemplate>

        <!-- Picks App / System / Shell (Icon view) or List / Detail per ViewMode. -->
        <ctrl:FileIconTemplateSelector x:Key="FileIconSelector"
                                       CustomTemplate="{StaticResource CustomFileTile}"
                                       SystemTemplate="{StaticResource SystemFileTile}"
                                       ShellTemplate="{StaticResource ShellFileTile}"
                                       ListTemplate="{StaticResource ListFileTile}"
                                       DetailTemplate="{StaticResource DetailFileTile}"/>
        <Style x:Key="TitleBarVisibilityStyle" TargetType="{x:Type Border}">
            <Setter Property="Visibility" Value="Visible"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowTitleBar, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- When ShowTitleBar=False (tabs visible), remove top corners -->
        <Style x:Key="FenceBorderStyle" TargetType="{x:Type Border}">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowTitleBar, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="False">
                    <Setter Property="CornerRadius" Value="0,0,10,10"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid>
        <!-- Outer glow border: accent / merge-target colored halo driven by VM flags.
             Rendered behind FenceBorder (same bounds) and carries the DropShadow.
             Invisible when no focus / drop / merge state is active. -->
        <Border x:Name="GlowBorder"
                Background="Transparent"
                BorderBrush="Transparent"
                IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource FenceBorderStyle}">
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="18" ShadowDepth="0" Opacity="0" />
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMergeTarget}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#6BD49A" BlurRadius="26" ShadowDepth="0" Opacity="0.55"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDropHover}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#7AA7E6" BlurRadius="20" ShadowDepth="0" Opacity="0.55"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsFocused}" Value="True">
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#7AA7E6" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- Main fence body -->
        <Border x:Name="FenceBorder"
                Background="{DynamicResource FenceBackgroundBrush}"
                BorderBrush="{DynamicResource FenceBorderBrush}"
                Opacity="{Binding FenceOpacity, FallbackValue=1.0}"
                Effect="{DynamicResource FenceShadowEffect}">
            <Border.Style>
                <Style TargetType="{x:Type Border}" BasedOn="{StaticResource FenceBorderStyle}">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsFocused}" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FenceBorderStrongBrush}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="TitleBarRow" Height="30" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Title Bar (drag handle + rename) -->
                <Border x:Name="TitleBarBorder" Grid.Row="0"
                        Style="{StaticResource TitleBarVisibilityStyle}"
                        Background="{DynamicResource TitleBarBrush}"
                        CornerRadius="6,6,0,0"
                        MouseLeftButtonDown="TitleBar_MouseLeftButtonDown"
                        ToolTip="{Binding PortalDisplayPath}"
                        ToolTipService.IsEnabled="{Binding IsPortalMode}">
                    <Grid>
                        <TextBlock x:Name="TitleText"
                                   Text="{Binding Title, FallbackValue='新建 Fence'}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="12,0,60,0" />
                        <Button x:Name="RollupToggleButton"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,30,0"
                                Style="{StaticResource DarkIconButtonStyle}"
                                ToolTip="折叠/展开"
                                Click="RollupToggleButton_Click">
                            <ContentControl x:Name="RollupIcon"
                                            Template="{StaticResource IconTemplate}"
                                            Tag="{StaticResource IconRollup}"
                                            Width="14" Height="14"
                                            RenderTransformOrigin="0.5,0.5">
                                <ContentControl.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </ContentControl.RenderTransform>
                            </ContentControl>
                        </Button>
                        <Button x:Name="TitleMenuButton"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,4,0"
                                Style="{StaticResource DarkIconButtonStyle}"
                                ToolTip="菜单"
                                Click="TitleMenuButton_Click">
                            <ContentControl Template="{StaticResource IconTemplate}"
                                            Tag="{StaticResource IconSettings}"
                                            Width="14" Height="14" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Phase 14: Detail view column header (visible only in Detail mode).
                     右侧 Margin 预留 ~14px 与垂直滚动条对齐。点击列头切换排序字段/方向。 -->
                <Border x:Name="DetailHeader" Grid.Row="1" Margin="4,2,4,0"
                        Background="{DynamicResource TitleBarBrush}" CornerRadius="3">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewMode}" Value="Detail">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid Margin="6,3,18,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="118"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HeaderName" Grid.Column="0" Text="名称" Tag="Name"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                   Cursor="Hand" MouseLeftButtonUp="DetailHeader_Click"/>
                        <TextBlock x:Name="HeaderSize" Grid.Column="1" Text="大小" Tag="Size"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                   TextAlignment="Right" Margin="0,0,12,0"
                                   Cursor="Hand" MouseLeftButtonUp="DetailHeader_Click"/>
                        <TextBlock x:Name="HeaderDate" Grid.Column="2" Text="修改时间" Tag="DateModified"
                                   Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11"
                                   Cursor="Hand" MouseLeftButtonUp="DetailHeader_Click"/>
                    </Grid>
                </Border>

                <!-- File icons area — ListBox with virtualization enabled.
                     ItemTemplateSelector switches between Icon-style tiles and the
                     Phase 14 List / Detail templates per fence ViewMode; the
                     ItemsPanel / scrollbars are swapped by the Style below. -->
                <ListBox x:Name="FileListBox"
                         Grid.Row="2"
                         ItemsSource="{Binding Files}"
                         ItemTemplateSelector="{StaticResource FileIconSelector}"
                         Background="Transparent"
                         BorderThickness="0"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         Margin="4,2,4,4">
                    <ListBox.Style>
                        <Style TargetType="ListBox">
                            <!-- Icon view (default): horizontal wrap, vertical scroll. -->
                            <Setter Property="ItemsPanel" Value="{StaticResource IconItemsPanel}" />
                            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ViewMode}" Value="List">
                                    <!-- List view: vertical wrap into columns, horizontal scroll.
                                         Pixel scrolling (CanContentScroll=False) keeps the
                                         column overflow smooth. -->
                                    <Setter Property="ItemsPanel" Value="{StaticResource ListItemsPanel}" />
                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
                                    <Setter Property="ScrollViewer.CanContentScroll" Value="False" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding ViewMode}" Value="Detail">
                                    <!-- Detail view: single virtualized column, vertical scroll. -->
                                    <Setter Property="ItemsPanel" Value="{StaticResource DetailItemsPanel}" />
                                    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                                    <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.Style>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <!-- Stretch lets Detail rows fill the column width. -->
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <!-- Empty state hint -->
                <TextBlock Grid.Row="2"
                           Foreground="{DynamicResource SubtleBorderBrush}"
                           FontSize="12"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="拖放文件到此处" />
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Files.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsPortalMode}" Value="True">
                                    <Setter Property="Text" Value="右键标题栏可更改映射文件夹" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- Rubber-band (marquee) selection overlay. Same Grid cell + margin as
                     FileListBox so its coordinate space aligns; never blocks hit-testing. -->
                <Canvas x:Name="MarqueeLayer" Grid.Row="2" Margin="4,2,4,4"
                        IsHitTestVisible="False" ClipToBounds="True">
                    <Rectangle x:Name="MarqueeRect"
                               Visibility="Collapsed"
                               StrokeThickness="1"
                               Fill="#3333AAFF"
                               Stroke="#CC33AAFF" />
                </Canvas>
            </Grid>
        </Border>

        <!-- Resize grips (8 directions) -->
        <Thumb x:Name="GripTop" Cursor="SizeNS" Opacity="0"
               VerticalAlignment="Top" Height="5" Margin="5,0"
               DragDelta="GripTop_DragDelta" DragCompleted="Grip_DragCompleted" />
        <Thumb x:Name="GripBottom" Cursor="SizeNS" Opacity="0"
               VerticalAlignment="Bottom" Height="5" Margin="5,0"
               DragDelta="GripBottom_DragDelta" DragCompleted="Grip_DragCompleted" />
        <Thumb x:Name="GripLeft" Cursor="SizeWE" Opacity="0"
               HorizontalAlignment="Left" Width="5" Margin="0,5"
               DragDelta="GripLeft_DragDelta" DragCompleted="Grip_DragCompleted" />
        <Thumb x:Name="GripRight" Cursor="SizeWE" Opacity="0"
               HorizontalAlignment="Right" Width="5" Margin="0,5"
